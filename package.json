{
  "name": "transit-app",
  "private": true,
  "description": "Personal real-time public transit app (Twin Cities, MN): Expo mobile app + Next.js API on Vercel.",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "verify": "biome check . && turbo run typecheck test"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/node": "^22.20.3",
    "turbo": "^2.10.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@12.4.2"
}
