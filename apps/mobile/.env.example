# Copy to .env.local (git-ignored) and fill in. Never commit real values.

# Transit API (apps/server). The key is the server's API_KEY.
EXPO_PUBLIC_API_URL=https://mobile-transport-app.vercel.app
EXPO_PUBLIC_API_KEY=

# Google Maps SDK for Android key, restricted to package dev.gamoro.transit. Read by app.config.ts at build time.
GOOGLE_MAPS_ANDROID_API_KEY=
