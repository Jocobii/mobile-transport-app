{
  "name": "@transit/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "adb:reverse": "adb reverse tcp:3000 tcp:3000 && adb reverse tcp:8081 tcp:8081",
    "android": "(pnpm adb:reverse || true) && expo run:android",
    "release:android": "EXPO_PUBLIC_API_URL=https://mobile-transport-app.vercel.app expo run:android --variant release",
    "ios": "expo run:ios",
    "release:ios": "EXPO_PUBLIC_API_URL=https://mobile-transport-app.vercel.app expo run:ios --configuration Release --device",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@tanstack/query-async-storage-persister": "5.103.1",
    "@tanstack/react-query": "5.103.1",
    "@tanstack/react-query-persist-client": "5.103.1",
    "@transit/api-client": "workspace:*",
    "@transit/contracts": "workspace:*",
    "expo": "~57.0.24",
    "expo-build-properties": "~57.0.21",
    "expo-constants": "~57.0.19",
    "expo-linking": "~57.0.10",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.19",
    "expo-router": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "i18next": "^26.4.2",
    "react": "19.2.3",
    "react-i18next": "^17.0.14",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
