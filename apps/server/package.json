{
  "name": "@transit/server",
  "version": "0.0.0",
  "private": true,
  "description": "Transit API (Next.js route handlers) deployed to Vercel.",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm run catalog:build && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "catalog:build": "tsx scripts/build-catalog.ts",
    "catalog:build:raw": "tsx scripts/build-catalog.ts --source=raw"
  },
  "dependencies": {
    "@transit/contracts": "workspace:*",
    "@transit/core": "workspace:*",
    "@transit/gtfs": "workspace:*",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@transit/config": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tsx": "^4.19.2",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "24.x"
  }
}
